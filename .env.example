# --- OmniQA Studio root env (copy to .env) ---
SPRING_PROFILES_ACTIVE=local
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws
# Prod (via gateway): VITE_API_URL=http://localhost:8081/api VITE_WS_URL=http://localhost:8081/ws

# Local dev: keep false (Caffeine cache, no Redis needed). Docker-compose sets true.
REDIS_ENABLED=false

# Service ingest key (set same for backend + automation engine in prod; empty = open dev)
SERVICE_API_KEY=

# DB (default Supabase PG; local profile uses H2 automatically)
DB_URL=jdbc:postgresql://db.nkqyjbtqzevqwkoltbd.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Auth / AI / Mail / GCS
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Local LLM fallback for /api/ai-test (merged from Autonomous; used when AI_API_KEY is empty)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Google Gemini (free tier) — first choice for AI generation when set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
GCS_BUCKET_NAME=omniqa-studio-assets
GCS_PROJECT_ID=omniqa-studio
GCS_CREDENTIALS_PATH=

# Gateway + Redis
BACKEND_URL=http://localhost:8080
BACKEND_WS_URL=ws://localhost:8080
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=6379
